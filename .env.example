# ================================================
# Presales AI Platform — Environment Configuration
# ================================================
# Copy this file to .env and configure your values
# Never commit .env to GitHub

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Model Assignments (updated June 2026)
# RFP analysis and reasoning
OLLAMA_ANALYSIS_MODEL=qwq:latest

# Compliance and enterprise content
OLLAMA_COMPLIANCE_MODEL=granite4.1:30b

# Proposal and summary writing
OLLAMA_WRITING_MODEL=qwen3.6:27b

# PPT content generation
OLLAMA_PPT_MODEL=qwen3.6:27b

# Fast pre-processing and vision
OLLAMA_FAST_MODEL=gemma4:e4b

# Agentic coding
OLLAMA_CODING_MODEL=devstral:latest

# Reasoning backup
OLLAMA_REASONING_BACKUP=deepseek-r1:32b

# RAG embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Output Configuration
OUTPUT_DIR=output
LOG_LEVEL=INFO
KNOWLEDGE_DIR=knowledge
CHROMA_DB_DIR=chroma_db
